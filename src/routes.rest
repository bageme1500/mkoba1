# Requests for the VS Code "REST Client" extension.
# Run `npm run seed -- --reset` first, then log in and paste the token below.

@base = http://localhost:4000
@token = paste-token-from-login-here

### Log in as the demo leader
POST {{base}}/auth/login
Content-Type: application/json

{ "phone": "0712345678", "password": "leader123" }

### Who am I
GET {{base}}/auth/me
Authorization: Bearer {{token}}

### Register a new group with its leader
POST {{base}}/auth/register-group
Content-Type: application/json

{
  "group": { "name": "Upendo M-Koba", "monthly_amount": 30000, "due_day": 28, "late_fine": 1000 },
  "leader": { "name": "Jane Leader", "phone": "0711000111", "password": "secret1" }
}

### Members of my group
GET {{base}}/users
Authorization: Bearer {{token}}

### Add a member (password optional: only if they will log in)
POST {{base}}/users
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Mwanaidi Ali", "phone": "0788 123 456", "joined_at": "2026-01-01" }

### Update group settings (affects months started afterwards)
PUT {{base}}/groups/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "monthly_amount": 50000, "due_day": 28, "late_fine": 2000 }

### Start a month for every active member (safe to repeat)
POST {{base}}/dues/generate
Authorization: Bearer {{token}}
Content-Type: application/json

{ "period": "2026-12" }

### Months and their status (filter by period and/or user_id)
GET {{base}}/dues?period=2026-11
Authorization: Bearer {{token}}

### Waive a member's fine for one month
PUT {{base}}/dues/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "late_fine": 0 }

### Record a payment ("period" optional: otherwise pays the oldest open month)
POST {{base}}/payments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "user_id": 3,
  "amount": 50000,
  "paid_at": "2026-11-05",
  "method": "mpesa",
  "reference": "TKR9X8Y7Z6",
  "period": "2026-11"
}

### Payments (filter by user_id, from, to)
GET {{base}}/payments?from=2026-11-01&to=2026-11-30
Authorization: Bearer {{token}}

### Upload a statement: step 1, see columns and suggested mapping
POST {{base}}/imports/preview
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=B

--B
Content-Disposition: form-data; name="file"; filename="sample-mpesa-statement.csv"
Content-Type: text/csv

< ../examples/sample-mpesa-statement.csv
--B--

### Upload a statement: step 2, import with a mapping
POST {{base}}/imports
Authorization: Bearer {{token}}
Content-Type: multipart/form-data; boundary=B

--B
Content-Disposition: form-data; name="mapping"

{"date":"Completion Time","amount":"Paid In","reference":"Receipt No.","name":"Details"}
--B
Content-Disposition: form-data; name="file"; filename="sample-mpesa-statement.csv"
Content-Type: text/csv

< ../examples/sample-mpesa-statement.csv
--B--

### Assign an unmatched statement row to a member
POST {{base}}/imports/rows/5/assign
Authorization: Bearer {{token}}
Content-Type: application/json

{ "user_id": 6 }

### Monthly report (add &format=xlsx or &format=pdf to download)
GET {{base}}/reports/monthly?period=2026-11
Authorization: Bearer {{token}}

### Yearly summary (add &format=xlsx or &format=pdf to download)
GET {{base}}/reports/yearly?year=2026
Authorization: Bearer {{token}}

### Who still owes this month + WhatsApp message (lang=sw or en)
GET {{base}}/reports/reminders?lang=sw
Authorization: Bearer {{token}}

### A member's own record (log in as 0754111222 / member123)
GET {{base}}/me/summary
Authorization: Bearer {{token}}

### ---------- Round 2 ----------

### Group settings: payment order, automatic months, opening balance
PUT {{base}}/groups/1
Authorization: Bearer {{token}}
Content-Type: application/json

{ "allocation_rule": "current_first", "auto_start": true, "opening_balance": 150000, "opening_balance_date": "2026-08-01" }

### Cash book summary for a month (balance now, last check, pending)
GET {{base}}/cashbook/summary?period=2026-11
Authorization: Bearer {{token}}

### Record money out (waits for a second leader)
POST {{base}}/cashbook/entries
Authorization: Bearer {{token}}
Content-Type: application/json

{ "direction": "out", "category": "expense", "amount": 15000, "occurred_at": "2026-11-20", "description": "Meeting refreshments" }

### Pending cash book entries
GET {{base}}/cashbook/entries?status=pending
Authorization: Bearer {{token}}

### Approve (must be a different leader from the one who recorded it)
POST {{base}}/cashbook/entries/1/approve
Authorization: Bearer {{token}}

### Reject with a reason
POST {{base}}/cashbook/entries/1/reject
Authorization: Bearer {{token}}
Content-Type: application/json

{ "reason": "No receipt provided" }

### Compare with the real M-Koba balance
POST {{base}}/cashbook/checks
Authorization: Bearer {{token}}
Content-Type: application/json

{ "checked_on": "2026-11-27", "actual_balance": 927000, "note": "From the M-Koba app" }

### Cash book statement (format=json|xlsx|pdf)
GET {{base}}/cashbook/report?period=2026-11&format=json
Authorization: Bearer {{token}}

### Member: report a payment (log in as 0754111222 / member123)
POST {{base}}/me/submissions
Authorization: Bearer {{token}}
Content-Type: application/json

{ "amount": 50000, "paid_at": "2026-11-26", "reference": "TKX123ABC", "note": "December early" }

### Leader: reported payments waiting
GET {{base}}/submissions?status=pending
Authorization: Bearer {{token}}

### Leader: counts for the navigation badges
GET {{base}}/submissions/counts
Authorization: Bearer {{token}}

### Leader: confirm a reported payment
POST {{base}}/submissions/1/approve
Authorization: Bearer {{token}}

### PDF receipt for a payment
GET {{base}}/payments/1/receipt
Authorization: Bearer {{token}}

### Activity log (area: payments|cashbook|members|months|imports|settings)
GET {{base}}/audit?area=payments&limit=20
Authorization: Bearer {{token}}

### 12-month trend
GET {{base}}/reports/trend?months=12
Authorization: Bearer {{token}}

### Change my language
PATCH {{base}}/auth/me
Authorization: Bearer {{token}}
Content-Type: application/json

{ "language": "en" }

### Log out all other devices (returns a new token for this one)
POST {{base}}/auth/logout-all
Authorization: Bearer {{token}}
