# Copy this file to .env and fill in your own values. Never commit .env.

PORT=4000

# postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/mkoba
# Used by `npm test` only. Tests wipe this database, so never point it at real data.
TEST_DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/mkoba_test

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Frontend address(es) allowed to call the API, comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# Timezone used for deadlines and fines.
APP_TIMEZONE=Africa/Dar_es_Salaam
